{
    "layer": "top",
    "position": "top",
    "height": 35,
    "margin": "0 0 0 0",
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/runner", 
        "hyprland/workspaces"
    ],
    
    "modules-center": [
        "clock"
    ],
    
    "modules-right": [
        "tray", 
        "wireplumber#sink",
        "wireplumber#source",
        "battery", 
        "custom/notification"
    ],

    "custom/runner": {
        "format": "𐕣",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "󰈹", 
            "2": "", 
            "3": "", 
            "4": "", 
            "5": "",
            
            "default": "󰩺"
        },
        "persistent-workspaces": {
        	"*": 5 
        }
    },

    "clock": {
        "format": "{:%a, %d %b %Y}",
        "format-alt": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "iso8601": true,
            "mode": "month",
            "format": {
                "today": "<span color='#c4746e'><b>{}</b></span>"
            }
        }
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󱅫",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "battery": {
        "states": { 
            "warning": 30, 
            "critical": 15 
        },

        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    "tray": {
        "icon-size": 20,
        "spacing": 8
    },

    "wireplumber#sink": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "tooltip-format": "{node_name}\nГромкость: {volume}%",
        "scroll-step": 1,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "max-volume": 100
    },

    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "󰍬 {volume}%",
        "format-muted": "󰍭",
        "tooltip-format": "{node_name}\nМикрофон: {volume}%",
        "scroll-step": 1,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    }
}
